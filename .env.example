# Connection Port (Defaults to 3000, hardcoded in sandbox ingress proxy)
PORT=3000

# Node Environment ("development" or "production")
NODE_ENV=production

# MongoDB Atlas Secret Connection URI (Option A - Preferred database)
# Leave blank to fall back automatically to memory JSON mock mode (Option B)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Google Gemini API secret authorization key
GEMINI_API_KEY=your_gemini_api_key

# CORS Whitelist Frontend Origin Address (e.g. your Vercel deployment URL)
FRONTEND_URL=https://bloodlink-ai.vercel.app

# Public Backend server URL (e.g. your Render deployment URL)
BACKEND_URL=https://bloodlink-ai.onrender.com
